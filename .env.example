# ==============================================================================
# CAPTODESK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or configure in Vercel Project Settings
# ==============================================================================

# Application Environment Tier ('development' | 'staging' | 'production' | 'test')
APP_ENV=production
NODE_ENV=production

# Base Application URL (Canonical production domain)
# Production: https://app.corvexastudio.com
# Staging:    https://staging.corvexastudio.com
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.corvexastudio.com

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings -> API -> Project API Keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project Settings -> API -> Project API Keys -> service_role (SECRET - SERVER-SIDE ONLY)
# Never expose to browser or client code!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# PLATFORM SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Comma-separated list of emails permitted to access the platform Super Admin (/admin)
SUPER_ADMIN_EMAILS=owner@yourdomain.com,cto@yourdomain.com

# Shared secret for authenticating automated background cron jobs
# Generated with: openssl rand -hex 32
CRON_SECRET=generate_a_random_32_byte_hex_string_for_cron

# ------------------------------------------------------------------------------
# TELNYX TELEPHONY & MESSAGING (Required for Live Calls & SMS)
# ------------------------------------------------------------------------------
# Telnyx Portal -> API Keys
TELNYX_API_KEY=KEY0123456789ABCDEF0123456789_abcdef...

# Telnyx Portal -> Public Key (For Ed25519 webhook signature verification)
TELNYX_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...

# Default fallback Telnyx number in E.164 format (+1XXXXXXXXXX)
TELNYX_PHONE_NUMBER=+15551234567

# ------------------------------------------------------------------------------
# STRIPE INVOICING & PAYMENTS (Optional in Dev, Required for Live Invoicing)
# ------------------------------------------------------------------------------
# Stripe Dashboard -> Developers -> API Keys (Secret Key)
# Production: sk_live_... | Test/Staging: sk_test_...
STRIPE_SECRET_KEY=sk_live_51...

# Stripe Dashboard -> Developers -> Webhooks -> Signing Secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...
