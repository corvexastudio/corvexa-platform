# ==============================================================================
# CAPTODESK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or configure in Vercel Project Settings
# ==============================================================================

# Application Environment Tier ('development' | 'staging' | 'production' | 'test')
APP_ENV=production
NODE_ENV=production

# Base Application URL (Canonical production domain)
# Production: https://app.captodesk.com
# Staging:    https://staging.captodesk.com
# Local:      http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.captodesk.com

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://vlztovqaummczupslymr.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public (or publishable)
# Used by browser clients for authenticated user sessions and public auth
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role
# [CRITICAL SECURITY REQUIREMENT]:
# 1. MUST BE CONFIGURED IN VERCEL ENVIRONMENT VARIABLES (Production + Preview).
# 2. MUST MATCH the exact project referenced in NEXT_PUBLIC_SUPABASE_URL.
#    (Do NOT mix up keys from different Supabase projects such as the dialer project;
#     a project mismatch will fail closed and reject server database operations).
# 3. This key is a SECRET and SERVER-SIDE ONLY. It bypasses RLS for webhooks,
#    background automations, and public tokenized workflows (quotes, invoices, booking).
# 4. NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# PLATFORM SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Comma-separated list of emails permitted to access the platform Super Admin (/admin)
# Users claiming super_admin without matching an email in this list are demoted to owner.
SUPER_ADMIN_EMAILS=owner@yourdomain.com,cto@yourdomain.com

# Shared secret for authenticating automated background cron jobs (/api/automations/worker)
# Required in production (fail-closed if missing). Header: Authorization: Bearer <CRON_SECRET>
# Generate a secure 32-byte hex token with: openssl rand -hex 32
CRON_SECRET=generate_a_random_32_byte_hex_string_for_cron

# Cryptographic secret for signing public booking tokens and preventing CSRF origin attacks
BOOKING_CSRF_SECRET=generate_a_random_32_byte_hex_string_for_csrf

# ------------------------------------------------------------------------------
# TELNYX TELEPHONY & MESSAGING (Required for Live Calls & SMS)
# Note: Live Telnyx operations remain intentionally deferred until paying customer go-live.
# ------------------------------------------------------------------------------
# Telnyx Portal -> API Keys
TELNYX_API_KEY=KEY0123456789ABCDEF0123456789_abcdef...

# Telnyx Portal -> Public Key (Required for Ed25519 inbound webhook signature verification)
TELNYX_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...

# Default fallback Telnyx phone number in E.164 format (+1XXXXXXXXXX)
TELNYX_PHONE_NUMBER=+15551234567

# Telnyx Call Control / SIP Application Connection ID
TELNYX_CONNECTION_ID=3057583306229941847

# Telnyx Messaging Profile ID (For 10DLC SMS routing)
TELNYX_MESSAGING_PROFILE_ID=40012345-6789-abcd-ef01-23456789abcd

# ------------------------------------------------------------------------------
# STRIPE INVOICING & HOMEOWNER PAYMENTS
# Note: CaptoDesk SaaS subscription billing is provider-independent and uses manual
# PayPal payments for early customers. Stripe credentials below are used strictly for
# client invoicing (homeowners paying contractor invoices online).
# ------------------------------------------------------------------------------
# Stripe Dashboard -> Developers -> API Keys (Secret Key)
# Production: sk_live_... | Test/Staging: sk_test_...
STRIPE_SECRET_KEY=sk_live_51...

# Stripe Dashboard -> Developers -> Webhooks -> Signing Secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# PAYPAL SAAS SUBSCRIPTION BILLING (Active Primary SaaS Billing Engine)
# ------------------------------------------------------------------------------
# PayPal Developer Dashboard -> Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# 'live' for real payments, or 'sandbox' for test accounts
PAYPAL_ENVIRONMENT=sandbox

# PayPal Recurring Subscription Plan IDs (Created in PayPal Dashboard -> Subscriptions)
NEXT_PUBLIC_PAYPAL_SOLO_PLAN_ID=P-SOLO-99-EXAMPLE-PLAN-ID
NEXT_PUBLIC_PAYPAL_FLEET_PLAN_ID=P-FLEET-199-EXAMPLE-PLAN-ID

# Webhook ID generated after creating webhook at https://app.captodesk.com/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Billing provider resolution: 'paypal' | 'stripe' | 'both' (defaults to 'paypal')
NEXT_PUBLIC_BILLING_PROVIDER=paypal

# ------------------------------------------------------------------------------
# WEB PUSH & VAPID (Required for Browser & Mobile PWA Push Notifications)
# Generate a VAPID keypair using: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Public VAPID key exposed to browser for PushManager.subscribe()
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...

# Private VAPID key kept strictly on the server for signing web push payloads
VAPID_PRIVATE_KEY=...

# Contact URI or mailto for push service identification
VAPID_SUBJECT=mailto:support@captodesk.com

